# RoomCraft 3D — all keys are OPTIONAL. The app works fully offline without any of them.
# Copy to `.env` (repo root or backend/) to override.

# Image-to-3D provider: mock | tripo3d | meshy
# "mock" generates procedural category-shaped GLBs locally (default, zero cost).
# If tripo3d/meshy is selected but its key is empty, the app falls back to mock.
IMAGE_TO_3D_PROVIDER=mock
TRIPO_API_KEY=
MESHY_API_KEY=

# Smart product extraction (URL importer). If set, an LLM is called ONLY when
# dimensions / price / category cannot be parsed from the page's structured data or regex.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Advanced (defaults shown)
# DATABASE_URL=sqlite:///backend/roomcraft.db
# STORAGE_DIR=backend/storage
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MOCK_GENERATION_SECONDS=2
